# Copy to .env.local

# Google Custom Search JSON API (primary)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# AI cover letters
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# JobSpy — Indeed / LinkedIn / Glassdoor scraper (Python 3.10+)
# Setup: pip install -r requirements.txt
# Docs: https://github.com/speedyapply/JobSpy
JOBSPY_ENABLED=true
JOBSPY_PYTHON=py -3.12
JOBSPY_SITES=indeed,linkedin,glassdoor
JOBSPY_RESULTS=15
JOBSPY_HOURS_OLD=168
JOBSPY_TIMEOUT_MS=120000

# Adzuna UK jobs (free — https://developer.adzuna.com/)
# Dashboard shows two values: Application ID (short) + Application Key (long)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
